    \u003Cp\u003ENyfiken p\u0026#xE5; vad som h\u0026#xE4;nder p\u0026#xE5; XLENT? H\u0026#xE4;r kan du l\u0026#xE4;sa v\u0026#xE5;ra senaste nyheter, insikter och se kommande events.\u003C/p\u003E\n            \u003C/div\u003E\n\n                \u003Cxlent-listing-item title=\u0022Morten Moen blir ny ledare f\u0026#xF6;r XLENT i Trondheim\u0022\n                                    link=\u0022/aktuellt/morten-moen-blir-ny-ledare-for-xlent-i-trondheim\u0022\n                                    link-text=\u0022L\u0026#xE4;s nyhet\u0022\n                                    tag-text=\u0022Nyhet\u0022\n                                    tag-type=\u0022News\u0022\n                                    image-src=\u0022https://cdn.xlent.se/media/phgohw41/morten-trondheim-xlent-3.jpg\u0022\u003E\n                \u003C/xlent-listing-item\u003E\n                \u003Cxlent-listing-item title=\u0022XLENT v\u0026#xE4;xer inom IT-management i V\u0026#xE4;stra G\u0026#xF6;taland\u0022\n                                    link=\u0022/aktuellt/xlent-vaxer-inom-it-management-i-vastra-gotaland\u0022\n                                    link-text=\u0022L\u0026#xE4;s nyhet\u0022\n                                    tag-text=\u0022Nyhet\u0022\n                                    tag-type=\u0022News\u0022\n                                    image-src=\u0022https://cdn.xlent.se/media/sbreeuwo/x-gbg-it-management-2024.jpg\u0022\u003E\n                \u003C/xlent-listing-item\u003E\n                \u003Cxlent-listing-item title=\u0022Social h\u0026#xE5;llbarhet i fokus f\u0026#xF6;r XLENT \u0022\n                                    link=\u0022/aktuellt/social-haallbarhet-i-fokus-foer-xlent\u0022\n                                    link-text=\u0022L\u0026#xE4;s nyhet\u0022\n                                    tag-text=\u0022Nyhet\u0022\n                                    tag-type=\u0022News\u0022\n                                    image-src=\u0022https://cdn.xlent.se/media/gdhckfei/xlent_artikel-hk.jpg\u0022\u003E\n                \u003C/xlent-listing-item\u003E\n\n                \u003Cdiv class=\u0022cta-block\u0022\u003E\n                    \u003Ca href=\u0022/aktuellt/\u0022\u003E\n                        Se allt inom Aktuellt\n                        \u003Ci class=\u0022xlent-icon-arrow-right\u0022\u003E\u003C/i\u003E\n                    \u003C/a\u003E\n                \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/div\u003E\n\u003C/div\u003E\n\n\n\u003Cdiv class=\u0022promotion-block overlay\u0022 \u003E\n    \n\n\n\u003Cdiv class=\u0022media \u0022 style=\u0022background-color: transparent\u0022\u003E\n        \u003Cpicture\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg?width=1920\u0026amp;format=webp\u0022 media=\u0022(min-width: 1600px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg?width=1920\u0026amp;format=jpg\u0022 media=\u0022(min-width: 1600px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg?width=1280\u0026amp;format=webp\u0022 media=\u0022(min-width: 900px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg?width=1280\u0026amp;format=jpg\u0022 media=\u0022(min-width: 900px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg?width=700\u0026amp;format=webp\u0022 media=\u0022(min-width: 500px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg?width=700\u0026amp;format=jpg\u0022 media=\u0022(min-width: 500px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg?width=600\u0026amp;format=webp\u0022 media=\u0022(min-width: 0)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg?width=600\u0026amp;format=jpg\u0022 media=\u0022(min-width: 0)\u0022 type=\u0022image/jpeg\u0022\u003E\n\n            \u003Cimg src=\u0022https://cdn.xlent.se/media/gf5pit3p/woman-looking-binoculars.jpg\u0022 alt=\u0022Woman Looking Binoculars\u0022 loading=\u0022lazy\u0022/\u003E\n        \u003C/picture\u003E\n\u003C/div\u003E\n\n\n    \u003Cdiv class=\u0022content align-center\u0022\u003E\n        \u003Ch2\u003ESpanar ni ocks\u0026#xE5; mot framtiden? \u003C/h2\u003E\n            \u003Cp\u003EHar ni sp\u0026#xE4;nnande planer f\u0026#xF6;r er verksamhet men beh\u0026#xF6;ver st\u0026#xF6;d med kompetens inom IT- eller verksamhetsutveckling? Kontakta n\u0026#xE5;got av v\u0026#xE5;ra team s\u0026#xE5; hj\u0026#xE4;lper vi er!\u003C/p\u003E\n\n            \u003Cdiv class=\u0022button-container\u0022\u003E\n                \n    \u003Cdiv class=\u0022cta-block\u0022\u003E\n            \u003Ca href=\u0022/kontor/\u0022 \u003E\n                Kontakta oss \n            \u003C/a\u003E\n    \u003C/div\u003E\n\n                \n\n            \u003C/div\u003E\n    \u003C/div\u003E\n\u003C/div\u003E\n\u003C/main\u003E\n\n\n    \u003Cxlent-search-modal number-of-search-results-text=\u0022S\u0026#xF6;kresultat\u0022\n                        placeholder-text=\u0022S\u0026#xF6;k p\u0026#xE5; sajten\u0022\n                        no-results-text=\u0022Inga tr\u0026#xE4;ffar\u0022\u003E\n    \u003C/xlent-search-modal\u003E\n\n    \n\n\u003Cfooter\u003E\n    \u003Cdiv class=\u0022content-container\u0022\u003E\n            \u003Cp\u003EVi skapar starka kundupplevelser, bygger h\u0026#xE5;llbara digitala l\u0026#xF6;sningar och st\u0026#xF6;ttar organisationer i f\u0026#xF6;r\u0026#xE4;ndring. Tillsammans f\u0026#xF6;rverkligar vi id\u0026#xE9;er \u0026#x2013; och det g\u0026#xF6;r vi p\u0026#xE5; m\u0026#xE5;nga olika s\u0026#xE4;tt.\u003C/p\u003E\n\n        \u003Cdiv class=\u0022contact\u0022\u003E\n            \u003Ch2\u003EKontakt\u003C/h2\u003E\n            \u003Cspan\u003EXLENT Sverige\u003C/span\u003E\n            \u003Ca href=\u0022mailto:info@xlent.se\u0022\u003Einfo@xlent.se\u003C/a\u003E\n                \u003Ca href=\u0022tel:\u0026#x2B;46851951000\u0022\u003E08-519 510 00\u003C/a\u003E\n\n                \u003Ca class=\u0022sibling-company-link\u0022 href=\u0022https://www.xlent.no/\u0022 target=\u0022_blank\u0022\u003EXLENT Norge\u003C/a\u003E\n        \u003C/div\u003E\n\n        \u003Cspan class=\u0022logo-container\u0022\u003E\n            \u003Ca href=\u0022/\u0022\u003E\n                \u003Cimg src=\u0022/images/logo-white.svg\u0022 alt=\u0022XLENT - G\u0026#xE5; till startsida\u0022 loading=\u0022lazy\u0022\u003E\n            \u003C/a\u003E\n            \u003Cspan\u003ECopyright \u0026copy; XLENT 2025\u003C/span\u003E\n        \u003C/span\u003E\n\n            \u003Cspan class=\u0022social-media-links\u0022\u003E\n                    \u003Ca href=\u0022https://facebook.com/xlent.se\u0022 target=\u0022_blank\u0022\u003E\u003Ci class=\u0022xlent-icon-facebook\u0022 role=\u0022img\u0022 aria-label=\u0022G\u0026#xE5; till XLENT facebook\u0022\u003E\u003C/i\u003E\u003C/a\u003E\n                    \u003Ca href=\u0022https://instagram.com/xlentconsultinggroup\u0022 target=\u0022_blank\u0022\u003E\u003Ci class=\u0022xlent-icon-instagram\u0022 role=\u0022img\u0022 aria-label=\u0022G\u0026#xE5; till XLENT instagram\u0022\u003E\u003C/i\u003E\u003C/a\u003E\n                    \u003Ca href=\u0022https://linkedin.com/in/company/-xlent\u0022 target=\u0022_blank\u0022\u003E\u003Ci class=\u0022xlent-icon-linkedin\u0022 role=\u0022img\u0022 aria-label=\u0022G\u0026#xE5; till XLENT linkedin\u0022\u003E\u003C/i\u003E\u003C/a\u003E\n            \u003C