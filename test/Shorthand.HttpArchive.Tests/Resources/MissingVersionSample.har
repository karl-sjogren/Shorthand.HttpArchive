    \u003Ca href=\u0022/\u0022 class=\u0022startpage-link\u0022\u003E\n                \u003Cimg class=\u0022logo\u0022 src=\u0022/images/logo-white.svg\u0022 alt=\u0022XLENT - G\u0026#xE5; till startsida\u0022\u003E\n            \u003C/a\u003E\n\n            \u003Cbutton class=\u0022open-menu-button\u0022 aria-label=\u0022\u0026#xD6;ppna meny\u0022\u003E\n                \u003Ci class=\u0022xlent-icon-hamburger\u0022\u003E\u003C/i\u003E\n            \u003C/button\u003E\n        \u003C/div\u003E\n\n        \u003Cul class=\u0022menu-items\u0022\u003E\n                        \u003Cli class=\u0022expandable-menu-item\u0022\u003E\n                            \u003Cspan class=\u0022link-container\u0022\u003E\n                                \u003Ca href=\u0022/erbjudande\u0022\u003E\n                                    Erbjudande\n                                \u003C/a\u003E\n                                \u003Cbutton class=\u0022expand-button\u0022 aria-label=\u0022Visa undermeny f\u0026#xF6;r Erbjudande\u0022\u003E\n                                    \u003Ci class=\u0022xlent-icon-chevron-down\u0022\u003E\u003C/i\u003E\n                                \u003C/button\u003E\n                            \u003C/span\u003E\n                            \u003Cdiv class=\u0022submenu-container\u0022\u003E\n                                \u003Cul\u003E\n                                        \u003Cli\u003E\n                                            \u003Ca href=\u0022/erbjudande/#business-intelligence-\u0026amp;-analytics\u0022\u003E\n                                                Business Intelligence \u0026amp; Analytics\n                                            \u003C/a\u003E\n                                        \u003C/li\u003E\n                                        \u003Cli\u003E\n                                            \u003Ca href=\u0022/erbjudande/#crm-\u0026amp;-verksamhetssystem\u0022\u003E\n                                                CRM \u0026amp; Verksamhetssystem\n                                            \u003C/a\u003E\n                                        \u003C/li\u003E\n                                        \u003Cli\u003E\n                                            \u003Ca href=\u0022/erbjudande/#cyber-security\u0022\u003E\n                                                Cyber Security\n                                            \u003C/a\u003E\n                                        \u003C/li\u003E\n                                        \u003Cli\u003E\n                                            \u003Ca href=\u0022/erbjudande/#ledarskap-\u0026amp;-f\u0026#xF6;r\u0026#xE4;ndring\u0022\u003E\n                                                Ledarskap \u0026amp; F\u0026#xF6;r\u0026#xE4;ndring\n                                            \u003C/a\u003E\n                                        \u003C/li\u003E\n                                        \u003Cli\u003E\n                                            \u003Ca href=\u0022/erbjudande/#strategi-\u0026amp;-digitalisering\u0022\u003E\n                                                Strategi \u0026amp; Digitalisering\n                                            \u003C/a\u003E\n                                        \u003C/li\u003E\n                                        \u003Cli\u003E\n                                            \u003Ca href=\u0022/erbjudande/#systemutveckling-\u0026amp;-integration-\u0022\u003E\n                                                Systemutveckling \u0026amp; Integration \n                                            \u003C/a\u003E\n                                        \u003C/li\u003E\n                                        \u003Cli\u003E\n                                            \u003Ca href=\u0022/erbjudande/#h\u0026#xE5;llbarhetsrapportering\u0022\u003E\n                                                H\u0026#xE5;llbarhetsrapportering\n                                            \u003C/a\u003E\n                                        \u003C/li\u003E\n\n                                \u003C/ul\u003E\n                            \u003C/div\u003E\n                        \u003C/li\u003E\n                        \u003Cli\u003E\n                            \u003Ca href=\u0022/kundcase\u0022\u003E\n                                Kundcase\n                            \u003C/a\u003E\n                        \u003C/li\u003E\n                        \u003Cli\u003E\n                            \u003Ca href=\u0022/om-oss\u0022\u003E\n                                Om oss\n                            \u003C/a\u003E\n                        \u003C/li\u003E\n                        \u003Cli\u003E\n                            \u003Ca href=\u0022/kontor\u0022\u003E\n                                Kontor\n                            \u003C/a\u003E\n                        \u003C/li\u003E\n                        \u003Cli\u003E\n                            \u003Ca href=\u0022/aktuellt\u0022\u003E\n                                Aktuellt\n                            \u003C/a\u003E\n                        \u003C/li\u003E\n                        \u003Cli\u003E\n                            \u003Ca href=\u0022/hallbarakonsulter\u0022\u003E\n                                H\u0026#xE5;llbara konsulter\n                            \u003C/a\u003E\n                        \u003C/li\u003E\n                        \u003Cli\u003E\n                            \u003Ca href=\u0022https://jobb.xlent.se/\u0022 class=\u0022external-link\u0022 target=\u0022_blank\u0022\u003E\n                                Jobba med oss\n                                \u003Ci class=\u0022xlent-icon-arrow-right\u0022\u003E\u003C/i\u003E\n                            \u003C/a\u003E\n                        \u003C/li\u003E\n            \u003Cli\u003E\n                \u003Cbutton class=\u0022search-link\u0022\u003E\n                    \u003Cspan class=\u0022search-link-text\u0022\u003ES\u0026#xF6;k\u003C/span\u003E\n                    \u003Ci class=\u0022xlent-icon-magnifying-glass\u0022\u003E\u003C/i\u003E\n                \u003C/button\u003E\n            \u003C/li\u003E\n        \u003C/ul\u003E\n    \u003C/nav\u003E\n\u003C/div\u003E\n\n\n\n\u003Cdiv class=\u0022header extra-large\u0022\u003E\n    \n\n\n\u003Cdiv class=\u0022media \u0022 style=\u0022background-color: transparent\u0022\u003E\n            \u003Cvideo title=\u0022XLENT Hero Svartvit\u0022 tabindex=\u0022-1\u0022 aria-hidden=\u0022true\u0022 loop playsinline autoplay muted\u003E\n                \u003Csource type=\u0022video/mp4\u0022 src=\u0022https://cdn.xlent.se/media/wkrefrtu/xlent-hero-svartvit.mp4\u0022 /\u003E\n                \u003Cmeta property=\u0022og:video\u0022 content=\u0022XLENT Hero Svartvit\u0022\u003E\n            \u003C/video\u003E\n\u003C/div\u003E\n\n\n    \u003Cdiv class=\u0022content align-left\u0022\u003E\n\n            \u003Ch1\u003ESmarta l\u0026#xF6;sningar och lokal expertis f\u0026#xF6;r organisationer i utveckling\u003C/h1\u003E\n\n\n            \u003Cdiv class=\u0022button-container\u0022\u003E\n                \n    \u003Cdiv class=\u0022cta-block\u0022\u003E\n            \u003Ca href=\u0022https://jobb.xlent.se/\u0022 target=\u0022_blank\u0022 \u003E\n                Utforska lediga tj\u0026#xE4;nster \n            \u003C/a\u003E\n    \u003C/div\u003E\n\n                \n\n            \u003C/div\u003E\n    \u003C/div\u003E\n\u003C/div\u003E\n\n    \n\u003Cmain\u003E\n\n\n\n\n\n\u003Cdiv class=\u0022content-block color-isabelline \u0022 \u003E\n    \u003Cdiv class=\u0022content-container \u0022\u003E\n        \u003Cdiv class=\u0022media-container\u0022\u003E\n            \n\n\n\u003Cdiv class=\u0022media \u0022 style=\u0022background-color: transparent\u0022\u003E\n        \u003Cpicture\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg?width=1920\u0026amp;format=webp\u0022 media=\u0022(min-width: 1600px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg?width=1920\u0026amp;format=jpg\u0022 media=\u0022(min-width: 1600px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg?width=1280\u0026amp;format=webp\u0022 media=\u0022(min-width: 900px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg?width=1280\u0026amp;format=jpg\u0022 media=\u0022(min-width: 900px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg?width=700\u0026amp;format=webp\u0022 media=\u0022(min-width: 500px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg?width=700\u0026amp;format=jpg\u0022 media=\u0022(min-width: 500px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg?width=600\u0026amp;format=webp\u0022 media=\u0022(min-width: 0)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg?width=600\u0026amp;format=jpg\u0022 media=\u0022(min-width: 0)\u0022 type=\u0022image/jpeg\u0022\u003E\n\n            \u003Cimg src=\u0022https://cdn.xlent.se/media/hlvcejoi/xlent-dzenan-pratar.jpg\u0022 alt=\u0022Xlent Dzenan Pratar\u0022 loading=\u0022lazy\u0022/\u003E\n        \u003C/picture\u003E\n\u003C/div\u003E\n\n\n                \u003Cimg class=\u0022yellow-accents\u0022 src=\u0022/images/yellow-accents.svg\u0022 alt=\u0022\u0022 /\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022content\u0022\u003E\n                \u003Ch2\u003EVi \u0026#xE4;r med och formar det nya digitala landskapet\u003C/h2\u003E\n\n                \u003Cp\u003EVi skapar starka kundupplevelser, bygger morgondagens digitala l\u0026#xF6;sningar och st\u0026#xF6;ttar organisationer i f\u0026#xF6;r\u0026#xE4;ndring f\u0026#xF6;r att f\u0026#xF6;rverkliga v\u0026#xE5;ra kunders id\u0026#xE9;er. Vi hj\u0026#xE4;lper till att koppla ihop verksamhet och teknik och det g\u0026#xF6;r vi p\u0026#xE5; m\u0026#xE5;nga olika s\u0026#xE4;tt. \u003C/p\u003E\n\n                \u003Cdiv class=\u0022button-container\u0022\u003E\n                    \n    \u003Cdiv class=\u0022cta-block\u0022\u003E\n            \u003Ca href=\u0022/om-oss/\u0022 \u003E\n                L\u0026#xE4;s mer om oss \n            \u003C/a\u003E\n    \u003C/div\u003E\n\n                    \n\n                \u003C/div\u003E\n\n        \u003C/div\u003E\n    \u003C/div\u003E\n\n\u003C/div\u003E\n\n\n\n\u003Cdiv class=\u0022content-block color-cambridge \u0022 \u003E\n    \u003Cdiv class=\u0022content-container right\u0022\u003E\n        \u003Cdiv class=\u0022media-container\u0022\u003E\n            \n\n\n\u003Cdiv class=\u0022media \u0022 style=\u0022background-color: transparent\u0022\u003E\n        \u003Cpicture\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg?width=1920\u0026amp;format=webp\u0022 media=\u0022(min-width: 1600px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg?width=1920\u0026amp;format=jpg\u0022 media=\u0022(min-width: 1600px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg?width=1280\u0026amp;format=webp\u0022 media=\u0022(min-width: 900px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg?width=1280\u0026amp;format=jpg\u0022 media=\u0022(min-width: 900px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg?width=700\u0026amp;format=webp\u0022 media=\u0022(min-width: 500px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg?width=700\u0026amp;format=jpg\u0022 media=\u0022(min-width: 500px)\u0022 type=\u0022image/jpeg\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg?width=600\u0026amp;format=webp\u0022 media=\u0022(min-width: 0)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg?width=600\u0026amp;format=jpg\u0022 media=\u0022(min-width: 0)\u0022 type=\u0022image/jpeg\u0022\u003E\n\n            \u003Cimg src=\u0022https://cdn.xlent.se/media/fo3lvrbm/mikaela-therese-square.jpg\u0022 alt=\u0022H\u0026#xE5;llbara konsulter\u0022 loading=\u0022lazy\u0022/\u003E\n        \u003C/picture\u003E\n\u003C/div\u003E\n\n\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022content\u0022\u003E\n                \u003Ch2\u003EH\u0026#xE5;llbara konsulter\u003C/h2\u003E\n\n                \u003Cp\u003EAtt trivas och m\u0026#xE5; bra p\u0026#xE5; jobbet ser vi som en sj\u0026#xE4;lvklarhet. D\u0026#xE4;rf\u0026#xF6;r har vi skapat H\u0026#xE5;llbara konsulter, v\u0026#xE5;rt initiativ f\u0026#xF6;r en h\u0026#xE5;llbar arbetskultur i konsultv\u0026#xE4;rlden. L\u0026#xE4;s mer om v\u0026#xE5;rt initiativ inom social h\u0026#xE5;llbarhet och hur vi arbetar med det p\u0026#xE5; XLENT.\u003C/p\u003E\n\n                \u003Cdiv class=\u0022button-container\u0022\u003E\n                    \n    \u003Cdiv class=\u0022cta-block\u0022\u003E\n            \u003Ca href=\u0022/hallbarakonsulter/\u0022 \u003E\n                L\u0026#xE4;s mer \n            \u003C/a\u003E