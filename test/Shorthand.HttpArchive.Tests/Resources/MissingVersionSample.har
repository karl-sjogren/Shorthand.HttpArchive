   \u003Cmeta property=\u0022og:video\u0022 content=\u0022Jobba Med Oss Svartvit Kort\u0022\u003E\n            \u003C/video\u003E\n\u003C/div\u003E\n\n\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022content\u0022\u003E\n                \u003Ch2\u003EUtvecklas tillsammans med oss\u003C/h2\u003E\n\n                \u003Cp\u003EOm du vill ha en sp\u0026#xE4;nnande och utmanande karri\u0026#xE4;r inom IT-branschen, d\u0026#xE5; kan XLENT vara r\u0026#xE4;tt plats f\u0026#xF6;r dig! Som konsult hos oss f\u0026#xE5;r du m\u0026#xF6;jlighet att vara med och p\u0026#xE5;verka, v\u0026#xE4;xa och utvecklas inom ditt omr\u0026#xE5;de \u0026#x2013; och dessutom utforska olika branscher genom sp\u0026#xE4;nnande uppdrag!\u003C/p\u003E\n\n                \u003Cdiv class=\u0022button-container\u0022\u003E\n                    \n    \u003Cdiv class=\u0022cta-block\u0022\u003E\n            \u003Ca href=\u0022https://jobb.xlent.se/\u0022 target=\u0022_blank\u0022 \u003E\n                Jobba med oss \n            \u003C/a\u003E\n    \u003C/div\u003E\n\n                    \n\n                \u003C/div\u003E\n\n        \u003C/div\u003E\n    \u003C/div\u003E\n\n\u003C/div\u003E\n\n\n\n\u003Cdiv class=\u0022highlighted-case-listing-block\u0022\u003E\n    \u003Cdiv class=\u0022listing-container \u0022\u003E\n        \u003Ch2\u003EUtvalda case\u003C/h2\u003E\n\n            \u003Cdiv class=\u0022highlighted-case\u0022 data-click-target=\u0022a\u0022\u003E\n                \n\n\n\u003Cdiv class=\u0022media \u0022 style=\u0022background-color: transparent\u0022\u003E\n        \u003Cpicture\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/mpcfftp4/unibake-xlent.jpg?width=1920\u0026amp;format=webp\u0022 media=\u0022(min-width: 1600px)\u0022 type=\u0022image/webp\u0022\u003E\n                \u003Csource srcset=\u0022https://cdn.xlent.se/media/mpcfftp4/unibake-xlent.jpg?width=1920\u0026amp;format=jpg\u0022 media=\u0022(min-width: 1600px)\u0022 type=\u00